# Use the URL and public anon key printed by `supabase status`.
# Never put a service_role key in the frontend.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-supabase-anon-key

# API prefix for the browser. Vite proxies /api to the local Java backend.
VITE_API_BASE=/api
API_PROXY_TARGET=http://127.0.0.1:8080

# Enable only after configuring send-contact-email and its mail provider.
VITE_CONTACT_EMAIL_ENABLED=false

# No official public domain is configured by default. Local pages stay noindex.
# Keep these aligned with deploy PUBLIC_SITE_ORIGIN/SEO_INDEXING_ENABLED.
VITE_PUBLIC_SITE_ORIGIN=
VITE_SEO_INDEXING_ENABLED=false
