# syntax=docker/dockerfile:1
FROM node:22-alpine AS build
WORKDIR /build
COPY client/package*.json ./
RUN --mount=type=cache,id=letmecook-npm22,target=/root/.npm,sharing=locked \
    npm ci --ignore-scripts --no-audit --no-fund
COPY client/ ./
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_PUBLIC_SITE_ORIGIN=""
ARG VITE_SEO_INDEXING_ENABLED="false"
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
ENV VITE_PUBLIC_SITE_ORIGIN=$VITE_PUBLIC_SITE_ORIGIN
ENV VITE_SEO_INDEXING_ENABLED=$VITE_SEO_INDEXING_ENABLED
ENV VITE_API_BASE=/api
RUN npm run build

FROM nginx:1.27-alpine
RUN apk add --no-cache nodejs
WORKDIR /app
COPY deploy/seo/ ./deploy/seo/
COPY client/src/utils/seo.js client/src/utils/recipeContent.js ./client/src/utils/
COPY client/package.json ./client/package.json
COPY deploy/nginx.conf /etc/nginx/nginx.conf
COPY --from=build /build/dist /usr/share/nginx/html
USER 1005:1005
ENTRYPOINT ["node", "/app/deploy/seo/web-entrypoint.mjs"]
