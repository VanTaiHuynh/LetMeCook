FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HOME=/app HF_HOME=/app/model/huggingface OMP_NUM_THREADS=2
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends espeak-ng && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir torch==2.6.0 --index-url https://download.pytorch.org/whl/cpu
COPY RecommendationSystem/requirements.txt RecommendationSystem/requirements.lock /tmp/
RUN pip install --no-cache-dir -r /tmp/requirements.txt -c /tmp/requirements.lock
COPY --chown=1005:1005 RecommendationSystem/ /app/
COPY --chown=1005:1005 deploy/provision-local-voice.py /app/deploy-provision-local-voice.py
RUN mkdir -p /app/data /app/model && chown -R 1005:1005 /app
USER 1005:1005
ENV OMP_NUM_THREADS=16 MKL_NUM_THREADS=16 OPENBLAS_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1 TOKENIZERS_PARALLELISM=false
CMD ["gunicorn", "-c", "/app/gunicorn.conf.py", "--workers", "1", "--threads", "8", "--bind", "127.0.0.1:9501", "--timeout", "180", "app:app"]
